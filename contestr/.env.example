# Codeforces
APP_CODEFORCES_API_KEY=
APP_CODEFORCES_API_SECRET=

# Admin JWT (опционально — оставьте пустым, чтобы отключить admin API)
APP_ADMIN_JWT_SECRET=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_JWT_TTL=24h

# Планировщик расписания туров
# APP_TIMETABLE_SYNC_INTERVAL=1s

# Yandex Object Storage — статический ключ SA (опционально).
# Endpoint, region, bucket, public_base_url — в configs/config.yaml
# https://yandex.cloud/ru/docs/iam/concepts/authorization/access-key
APP_OBJECT_STORAGE_ACCESS_KEY_ID=
APP_OBJECT_STORAGE_SECRET_ACCESS_KEY=
